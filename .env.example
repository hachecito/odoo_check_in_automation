ODOO_URL=https://miempresa.odoo.com
# Optional, only if the instance has several databases
ODOO_DB=
ODOO_LOGIN=usuario@empresa.com
ODOO_PASSWORD=cambiar

TZ_NAME=Europe/Madrid
# Random delay before clicking (0 = disabled)
JITTER_MAX_MINUTES=5
# Skip if the last check-in/out is more recent than this (double-trigger guard)
MIN_TOGGLE_MINUTES=60
POST_LOGIN_PAUSE_SECONDS=3

# Optional override; default is language-independent
SYSTRAY_SELECTOR=
